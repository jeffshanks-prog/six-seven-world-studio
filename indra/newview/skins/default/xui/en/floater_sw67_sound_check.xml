<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- 6|7 World Studio: Sound Check (DJ and Hosting). Keyboard: Tab moves through the switches and sliders (arrow keys change them). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="436"
 width="540"
 min_height="436"
 min_width="540"
 layout="topleft"
 name="sw67_sound_check"
 save_rect="true"
 title="6|7 SOUND CHECK">
  <text
   follows="left|top|right"
   height="30"
   left="10"
   top="8"
   name="intro_text"
   width="520"
   wrap="true"
   layout="topleft">Sound Check: MONITOR ONLY. You broadcast your stream from your own app, so nothing here changes what your listeners hear.</text>
  <text
   follows="left|top|right"
   height="64"
   left="10"
   top="40"
   name="paths_text"
   width="520"
   wrap="true"
   layout="topleft"></text>
  <check_box
   height="16"
   label="Monitor EQ on"
   left="10"
   top="108"
   name="sc_on_check"
   tab_group="1"
   width="160"
   initial_value="false"
   tool_tip="Applies the three bands and input gain to what this viewer mixes: world and interface sounds."
   layout="topleft" />
  <check_box
   height="16"
   label="Apply EQ to Broadcast (Monitor Only: not available)"
   left="180"
   top="108"
   name="broadcast_check"
   tab_group="1"
   width="330"
   initial_value="false"
   tool_tip="This viewer does not send your broadcast, so it can't change it. This stays off."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="Low"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="low_slider"
   tab_group="1"
   top="134"
   width="360"
   tool_tip="Below about 250 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="Mid"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="mid_slider"
   tab_group="1"
   top="158"
   width="360"
   tool_tip="About 500 Hz to 2 kHz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="High"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="high_slider"
   tab_group="1"
   top="182"
   width="360"
   tool_tip="4 kHz and up, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="Input gain"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="input_slider"
   tab_group="1"
   top="206"
   width="360"
   tool_tip="Gain before the meters, -12 to +12 dB."
   layout="topleft" />
  <button
   follows="left|top"
   height="23"
   label="Reset"
   left="380"
   top="134"
   name="sc_reset_btn"
   tab_group="1"
   width="80"
   layout="topleft" />
  <text
   follows="left|top"
   height="16"
   left="10"
   top="236"
   name="meters_heading"
   width="520"
   font="SansSerifBold"
   layout="topleft">Output levels (this viewer's mix):</text>
  <text
   follows="left|top|right"
   height="64"
   left="10"
   top="254"
   name="meters_text"
   width="520"
   wrap="true"
   layout="topleft"></text>
  <text
   follows="left|top|right"
   height="18"
   left="10"
   top="320"
   name="clip_text"
   width="520"
   font="SansSerifBold"
   layout="topleft"></text>
  <text
   follows="left|top|right"
   height="48"
   left="10"
   top="342"
   name="stream_text"
   width="520"
   wrap="true"
   layout="topleft"></text>
  <text
   follows="left|bottom|right"
   height="34"
   left="10"
   top="394"
   name="status_text"
   width="520"
   wrap="true"
   layout="topleft"></text>
</floater>
