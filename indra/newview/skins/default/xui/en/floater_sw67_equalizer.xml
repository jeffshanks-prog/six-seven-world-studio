<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- 6|7 World Studio: Sound Equalizer (Basic). Keyboard: Tab moves through the switches, the source, each band (arrow keys change it), presets and reset. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="552"
 width="520"
 min_height="552"
 min_width="520"
 layout="topleft"
 name="sw67_equalizer"
 save_rect="true"
 title="6|7 SOUND EQUALIZER">
  <text
   follows="left|top|right"
   height="30"
   left="10"
   top="8"
   name="intro_text"
   width="500"
   wrap="true"
   layout="topleft">Changes only what you hear. Each band's value is in dB; use the arrow keys or type a number.</text>
  <check_box
   height="16"
   label="Equalizer on"
   left="10"
   top="42"
   name="master_check"
   tab_group="1"
   width="140"
   initial_value="false"
   tool_tip="The master switch: off sends every source through unchanged (bypass)."
   layout="topleft" />
  <text
   follows="left|top"
   height="16"
   left="160"
   top="44"
   name="source_label"
   width="50"
   layout="topleft">Source:</text>
  <combo_box
   layout="topleft"
   follows="left|top"
   height="23"
   left="212"
   top="40"
   name="source_combo"
   tab_group="1"
   width="180">
    <combo_box.item label="World sounds" name="world" value="world" />
    <combo_box.item label="Interface sounds" name="ui" value="ui" />
    <combo_box.item label="Parcel music" name="music" value="music" />
    <combo_box.item label="Voice chat" name="voice" value="voice" />
  </combo_box>
  <check_box
   height="16"
   label="Equalize this source"
   left="10"
   top="70"
   name="source_on_check"
   tab_group="1"
   width="200"
   initial_value="false"
   layout="topleft" />
  <text
   follows="left|top|right"
   height="44"
   left="10"
   top="90"
   name="limitation_text"
   width="500"
   wrap="true"
   layout="topleft"></text>
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="31 Hz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_0"
   tab_group="1"
   top="136"
   width="330"
   tool_tip="Gain at 31 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="62 Hz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_1"
   tab_group="1"
   top="158"
   width="330"
   tool_tip="Gain at 62 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="125 Hz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_2"
   tab_group="1"
   top="180"
   width="330"
   tool_tip="Gain at 125 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="250 Hz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_3"
   tab_group="1"
   top="202"
   width="330"
   tool_tip="Gain at 250 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="500 Hz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_4"
   tab_group="1"
   top="224"
   width="330"
   tool_tip="Gain at 500 Hz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="1 kHz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_5"
   tab_group="1"
   top="246"
   width="330"
   tool_tip="Gain at 1 kHz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
