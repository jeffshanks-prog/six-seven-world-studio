   height="18"
   increment="0.5"
   initial_value="0"
   label="4 kHz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_7"
   tab_group="1"
   top="290"
   width="330"
   tool_tip="Gain at 4 kHz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
   increment="0.5"
   initial_value="0"
   label="8 kHz"
   label_width="70"
   left="10"
   min_val="-12"
   max_val="12"
   name="band_8"
   tab_group="1"
   top="312"
   width="330"
   tool_tip="Gain at 8 kHz, -12 to +12 dB."
   layout="topleft" />
  <slider
   can_edit_text="true"
   decimal_digits="1"
   follows="left|top"
   height="18"
