   name="band_9"
   tab_group="1"
   top="334"
   width="330"
   tool_tip="Gain at 16 kHz, -12 to +12 dB."
   layout="topleft" />
  <text
   follows="left|top"
   height="16"
   left="10"
   top="366"
   name="preset_label"
   width="50"
   layout="topleft">Preset:</text>
  <combo_box
   follows="left|top"
   height="23"
   left="62"
   top="362"
   name="preset_combo"
   tab_group="1"
   width="180"
   layout="topleft" />
  <button
   follows="left|top"
   height="23"
   label="Reset source"
   left="248"
   top="362"
   name="reset_btn"
   tab_group="1"
   width="110"
   tool_tip="Sets this source flat and turns its equalizer off."
   layout="topleft" />
  <line_editor
   follows="left|top"
   height="23"
   left="10"
   top="390"
   name="preset_name"
   tab_group="1"
   width="232"
   max_length_bytes="40"
   default_text="Name for a custom preset"
   layout="topleft" />
  <button
   follows="left|top"
   height="23"
   label="Save preset"
   left="248"
   top="390"
   name="save_preset_btn"
   tab_group="1"
   width="110"
   layout="topleft" />
  <button
   follows="left|top"
   height="23"
   label="Delete preset"
   left="362"
   top="390"
   name="delete_preset_btn"
   tab_group="1"
   width="110"
   tool_tip="Deletes the selected custom preset. Built-in presets can't be deleted."
   layout="topleft" />
  <text
   follows="left|top"
   height="16"
   left="10"
   top="424"
   name="meters_heading"
   width="500"
   font="SansSerifBold"
   layout="topleft">Levels (peak and RMS, with a word for each):</text>
  <text
   follows="left|top|right"
   height="64"
   left="10"
   top="442"
   name="meters_text"
   width="500"
   wrap="true"
   layout="topleft"></text>
  <text
   follows="left|bottom|right"
   height="34"
   left="10"
   top="510"
   name="status_text"
   width="500"
   wrap="true"
   layout="topleft"></text>
</floater>
