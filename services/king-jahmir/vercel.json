{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,**/__pycache__/**,*.sqlite3}"
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__kjpath=:path*" }
  ],
  "crons": [
    { "path": "/cron/purge", "schedule": "17 4 * * *" }
  ]
}
